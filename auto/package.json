{
  "name": "stars-clique-sync-auto-desktop",
  "description": "Stars Clique Sync Auto - manual and Whisper-assisted lyric timing",
  "author": "Mikhail Mikhalchenko (Goth Angel)",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "wavesurfer.js": "^7.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "artifactName": "Stars-Clique-Sync-Auto-Setup-${version}.${ext}",
    "appId": "com.starsclique.sync.auto",
    "productName": "Stars Clique Sync Auto",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stars Clique Sync Auto",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "../LICENSE.md",
        "to": "LICENSE.md"
      },
      {
        "from": "../docs",
        "to": "manuals",
        "filter": [
          "stars-clique-sync-guide-*.pdf"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "backend/dist/stars-sync-backend",
        "to": "backend/stars-sync-backend",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
